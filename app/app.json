{
  "expo": {
    "name": "KineticCoach",
    "slug": "kinetic-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kineticcoach.app",
      "appleTeamId": "483V5ZV6G5",
      "infoPlist": {
        "NSCameraUsageDescription": "KineticCoach uses the camera to check your exercise form in real time. Video stays on your phone and is never uploaded."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kineticcoach.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-font",
      "expo-sqlite"
    ],
    "scheme": "kineticcoach",
    "experiments": {
      "typedRoutes": false
    }
  }
}
